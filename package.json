{
  "name": "git-ai-auto-commit",
  "displayName": "Git AI Auto Commit",
  "description": "使用 AI 自动生成 Git 提交消息并提交",
  "version": "0.1.0",
  "publisher": "zstings",
  "bugs": {
    "url": "https://github.com/zstings/git-ai-auto-commit/issues"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zstings/git-ai-auto-commit.git"
  },
  "categories": [
    "AI",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "commit",
    "ai",
    "auto-commit",
    "openai",
    "claude",
    "deepseek",
    "conventional commits"
  ],
  "activationEvents": [
    "*"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitAiAutoCommit.generateAndCommit",
        "title": "AI 生成提交消息并直接提交",
        "category": "Git AI Auto Commit"
      },
      {
        "command": "gitAiAutoCommit.generateToScm",
        "title": "AI 生成提交消息到输入框",
        "category": "Git AI Auto Commit",
        "icon": "$(sparkle)"
      },
      {
        "command": "gitAiAutoCommit.openConfig",
        "title": "打开配置",
        "category": "Git AI Auto Commit"
      },
      {
        "command": "gitAiAutoCommit.openConfigPage",
        "title": "打开配置页面",
        "category": "Git AI Auto Commit",
        "icon": "$(settings-gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitAiAutoCommit-sidebar",
          "title": "Git AI Auto Commit",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "gitAiAutoCommit-sidebar": [
        {
          "type": "webview",
          "id": "gitAiAutoCommit.configView",
          "name": "配置"
        }
      ]
    },
    "menus": {
      "scm/title": [
        {
          "command": "gitAiAutoCommit.generateToScm",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "view/title": [
        {
          "command": "gitAiAutoCommit.openConfigPage",
          "group": "navigation",
          "when": "view == gitAiAutoCommit.configView"
        }
      ]
    },
    "configuration": {
      "title": "Git AI Auto Commit",
      "properties": {
        "gitAiAutoCommit.apiKey": {
          "type": "string",
          "default": "",
          "description": "AI 服务的 API Key（建议在配置页面中管理）"
        },
        "gitAiAutoCommit.baseUrl": {
          "type": "string",
          "default": "",
          "description": "API 基础地址（建议在配置页面中管理）"
        },
        "gitAiAutoCommit.model": {
          "type": "string",
          "default": "",
          "description": "AI 模型名称（建议在配置页面中管理）"
        },
        "gitAiAutoCommit.commitStyle": {
          "type": "string",
          "enum": [
            "conventional",
            "simple"
          ],
          "enumDescriptions": [
            "Conventional Commits 风格（如 feat: / fix: / docs: 等）",
            "简洁风格（直接描述变更内容）"
          ],
          "default": "conventional",
          "description": "提交消息风格"
        },
        "gitAiAutoCommit.language": {
          "type": "string",
          "enum": [
            "zh",
            "en"
          ],
          "enumDescriptions": [
            "中文提交消息",
            "英文提交消息"
          ],
          "default": "zh",
          "description": "提交消息语言"
        },
        "gitAiAutoCommit.maxDiffLines": {
          "type": "number",
          "default": 500,
          "description": "发送给 AI 的最大 diff 行数（超出将截断）"
        },
        "gitAiAutoCommit.autoStageAll": {
          "type": "boolean",
          "default": false,
          "description": "提交前自动执行 git add -A（暂存所有变更）"
        },
        "gitAiAutoCommit.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "显示操作完成的通知"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "pnpm run lint",
    "test": "node test/run-tests.js",
    "build": "pnpm vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "1.94.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "keytar"
    ]
  }
}
